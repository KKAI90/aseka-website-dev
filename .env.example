# Supabase — lấy từ supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend — lấy từ resend.com → API Keys (free: 3000 email/tháng)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=info@aseka.jp
RESEND_TO_EMAIL=contact@aseka.jp

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# S3 — file uploads on /dang-ky (ảnh chân dung, giấy tờ tuỳ thân, chứng chỉ).
# Bucket MUST be private (Block all public access ON) — these are ID documents.
# Admin views files via short-lived presigned URLs, never a permanent public link.
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-northeast-1
S3_BUCKET_NAME=aseka-dev-candidate-files
