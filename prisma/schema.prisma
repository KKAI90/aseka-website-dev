generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model candidates {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?
  name_kana      String?
  email          String?
  phone          String?
  gender         String?
  date_of_birth  String?
  nationality    String?
  address        String?
  visa_type      String?
  visa_expiry    String?
  jlpt           String?
  jlpt_actual    String?
  jlpt_exam_year   String?
  jlpt_exam_month  String?
  jlpt_exam_status String?
  height_cm      Float?
  weight_kg      Float?
  skill          String?
  preferred_job  String?
  preferred_location String?
  work_hours     String?
  availability   String?
  marital_status String?
  dependents     String?
  education      Json?
  work_history   Json?
  certifications Json?
  motivation     String?
  self_pr        String?
  status         String?  @default("new")
  match_job_id   String?
  match_job_name String?
  note           String?
  cv_filename    String?
  photo_url        String?
  id_front_url     String?
  id_back_url      String?
  jlpt_cert_url    String?
  senmonkyu_url    String?
  other_cert_url   String?
  password_hash  String?
  applied_via    String?
  applied_at     DateTime?
  applied_reviewed Boolean @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
}

model mypage_favorites {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id String   @db.Uuid
  job_id       String   @db.Uuid
  created_at   DateTime @default(now())

  @@unique([candidate_id, job_id])
}

model job_listings {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company           String?
  position_ja       String?
  position_vn       String?
  industry          String?
  location          String?
  jlpt_min          String?
  salary            String?
  count             Int?     @default(1)
  status            String?  @default("open")
  osusume_point     String?
  position_name     String?
  position_note     String?
  job_description   String?
  requirements      String?
  qualifications    String?
  language_skills   String?
  education_req     String?
  work_location     String?
  selection_process String?
  work_environment  String?
  annual_income     String?
  visa_type         String?
  salary_type       String?
  salary_note       String?
  employment_type   String?
  work_hours        String?
  trial_period      String?
  insurance         String?
  holidays          String?
  remarks           String?
  reference_url     String?
  // Cached machine translation of the free-text fields, keyed by target language:
  // { en: { job_description: "...", requirements: "...", ... }, vi: { ... } }.
  // Populated once when a job is created/updated (src/lib/translate.ts, MyMemory API — free,
  // no per-request cost), not re-translated on every candidate view. null/missing keys just
  // fall back to the original Japanese text on mypage.
  translations      Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt
}

model contact_submissions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String?
  name       String?
  company    String?
  email      String?
  phone      String?
  service    String?
  message    String?
  status     String?  @default("new")
  created_at DateTime @default(now())
}

model admin_users {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  password   String
  created_at DateTime @default(now())
}
